import os
import sys
import base64
import tkinter as tk
from tkinter import messagebox

# Embedded versions of the supplied Scan and Print scripts.
_SCAN_SOURCE = base64.b64decode(
    """"""
).decode("utf-8")

_PRINT_SOURCE = base64.b64decode(
    """"""
).decode("utf-8")

BG = "#17191e"
FG = "#f1f3f6"
MUTED = "#a5adba"
ACCENT = "#4c8bf5"
HOVER = "#376fd0"

WINDOW_WIDTH = 420
WINDOW_HEIGHT = 260
BUTTON_WIDTH = 350
BUTTON_HEIGHT_PX = 44


def run_embedded(source, module_name):
    # A separate namespace prevents Scan/Print globals from colliding.
    namespace = {
        "__name__": "__main__",
        "__file__": os.path.abspath(sys.executable if getattr(sys, "frozen", False) else __file__),
        "__package__": None,
    }
    exec(compile(source, module_name, "exec"), namespace, namespace)


def launch_action(action):
    source = _SCAN_SOURCE if action == "Scan" else _PRINT_SOURCE
    module_name = "canon_scan_embedded.pyw" if action == "Scan" else "canon_print_embedded.pyw"
    try:
        root.destroy()
        run_embedded(source, module_name)
    except Exception as exc:
        try:
            messagebox.showerror(
                "Canon",
                f"Could not start {action}:\n\n{exc}"
            )
        except Exception:
            pass


root = tk.Tk()
root.title("Canon")
root.geometry(f"{WINDOW_WIDTH}x{WINDOW_HEIGHT}+80+80")
root.resizable(False, False)
root.configure(bg=BG)

tk.Label(
    root,
    text="Canon",
    font=("Segoe UI", 24, "bold"),
    bg=BG,
    fg=FG
).place(x=0, y=32, width=WINDOW_WIDTH, height=38)

tk.Label(
    root,
    text="What would you like to do?",
    font=("Segoe UI", 10),
    bg=BG,
    fg=MUTED
).place(x=0, y=80, width=WINDOW_WIDTH, height=20)


def make_button(text, command):
    return tk.Button(
        root,
        text=text,
        command=command,
        font=("Segoe UI", 10, "bold"),
        bg=ACCENT,
        fg="white",
        activebackground=HOVER,
        activeforeground="white",
        relief="flat",
        bd=0,
        cursor="hand2",
        padx=0,
        pady=0,
        wraplength=BUTTON_WIDTH
    )


make_button("Scan", lambda: launch_action("Scan")).place(
    x=(WINDOW_WIDTH - BUTTON_WIDTH) // 2,
    y=125,
    width=BUTTON_WIDTH,
    height=BUTTON_HEIGHT_PX
)
make_button("Print", lambda: launch_action("Print")).place(
    x=(WINDOW_WIDTH - BUTTON_WIDTH) // 2,
    y=179,
    width=BUTTON_WIDTH,
    height=BUTTON_HEIGHT_PX
)

root.mainloop()
